{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(jj status*)",
      "Bash(jj log*)",
      "Bash(jj diff*)",
      "Bash(jj show*)",
      {if:justfile}
      "Bash(just*)",
      {endif:justfile}
      {if:flake}
      "Bash(nix flake check*)",
      "Bash(nix eval*)",
      "Bash(nix build --dry-run*)",
      "Bash(nix search nixpkgs*)",
      "Bash(statix check*)",
      "Bash(deadnix*)",
      "Bash(nixfmt*)",
      {endif:flake}
      {if:rust}
      "Bash(cargo check*)",
      "Bash(cargo fmt*)",
      "Bash(cargo nextest run*)",
      "Bash(cargo test*)",
      "Bash(cargo tree*)",
      {endif:rust}
      {if:clippy}
      "Bash(cargo clippy*)",
      {clippyif:clippy}
      {if:machete}
      "Bash(cargo machete*)",
      {endif:machete}
      {if:deny}
      "Bash(cargo deny check*)",
      {endif:deny}
      {if:audit}
      "Bash(cargo audit*)",
      {endif:audit}
      {if:taplo}
      "Bash(taplo*)",
      {endif:taplo}
      {if:typos}
      "Bash(typos*)",
      {endif:typos}
      {if:committed}
      "Bash(committed*)",
      {endif:committed}
      {if:cliff}
      "Bash(git cliff*)"
      {endif:cliff}
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(jj git push*)",
      "Bash(git commit*)",
      "Bash(jj commit*)",
      "Bash(jj describe*)",
      "Bash(git tag*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(jj rebase*)",
      "Bash(jj abandon*)",
      "Bash(jj bookmark*)",
      "Bash(gh pr create*)",
      "Bash(gh release*)",
      {if:rust}
      "Bash(cargo publish*)",
      {endif:rust}
      {if:justfile}
      "Bash(just publish*)",
      {endif:justfile}
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./secrets/**)",
      {if:envrc}
      "Read(./.direnv/**)"
      {endif:envrc}
    ]
  }
}
